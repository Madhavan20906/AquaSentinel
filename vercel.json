{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "aquasentinel": {
      "root": "artifacts/aquasentinel"
    },
    "api-server": {
      "root": "artifacts/api-server"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api-server"
      }
    },
    {
      "source": "/healthz",
      "destination": {
        "service": "api-server"
      }
    },
    {
      "source": "/uploads/(.*)",
      "destination": {
        "service": "api-server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "aquasentinel"
      }
    }
  ]
}
